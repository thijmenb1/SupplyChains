;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SupplyChains"
run/main_scene="uid://be4p1qvhdecyd"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Global="*uid://ftknauo8ebot"
VehicleManager="*uid://b63jtdb02jblj"
Tiles="*uid://cxn577r1pc8mi"
GridManager="*uid://4kc4d2gimv0h"
TradeSystem="*uid://bvphug6qryibc"
Save="*uid://d1frtamvb3764"

[display]

